Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/run_cluster_et_partial_pythia.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:100
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

# Pilot defaults: first 1,000 synchronized four-stream files, 10 per process.
total_files        = 200000
files_per_job      = 20
n_chunks           = 10000
chunk_offset       = 0
input_manifest     = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/input/minimum_bias/segments.list
partial_output_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/cluster_et_partial/prompt_pi0_eta07
log_directory      = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor
n_bins             = 100
et_max             = 20.0
truth_eta_max      = 0.7
cluster_eta_max    = 0.7
min_cluster_energy = 0.2
dominant_fraction_min = 0.5
pi0_contributor_fraction_min = 0.5
separated_dr       = 0.03
merged_dr          = 0.06
response_min       = 0.5
response_max       = 1.5

Output             = $(log_directory)/pythia_cluster_et_partial_$(ClusterId)_$(ProcId).out
Error              = $(log_directory)/pythia_cluster_et_partial_$(ClusterId)_$(ProcId).err
Log                = /tmp/ryotaro-PhotonAnalysisTree-pythia-cluster-et-partial_$(ClusterId).$(ProcId).log
Arguments          = "$(ProcId) $(chunk_offset) $(total_files) $(files_per_job) $(input_manifest) $(partial_output_directory) $(n_bins) $(et_max) $(truth_eta_max) $(cluster_eta_max) $(min_cluster_energy) $(dominant_fraction_min) $(pi0_contributor_fraction_min) $(separated_dr) $(merged_dr) $(response_min) $(response_max)"

# Require n_chunks = ceil(total_files / files_per_job) - chunk_offset.
Queue $(n_chunks)
