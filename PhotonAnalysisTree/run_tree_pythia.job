Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/run_tree_pythia.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:100
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

n_events           = 0
tree_output_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/root
log_directory      = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor

Output             = $(log_directory)/pythia_tree_$(ClusterId).$(ProcId).out
Error              = $(log_directory)/pythia_tree_$(ClusterId).$(ProcId).err
Log                = /tmp/ryotaro-PhotonAnalysisTree-pythia-tree_$(ClusterId).$(ProcId).log
Arguments          = "$(input_suffix) $(n_events) $(tree_output_directory)"

# One manifest row is one synchronized four-stream DST file set.
Queue input_suffix from input/jet5/segments_copy.list
