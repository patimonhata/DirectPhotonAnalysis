Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/run_truth_pt_partial_pythia.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:100
request_memory     = 2GB
Priority           = 20
job_lease_duration = 86400

# Defaults: first 40,000 truth trees, 500 per process, exactly 80 jobs.
total_files        = 40000
files_per_job      = 500
n_chunks           = 80
chunk_offset       = 0
input_manifest     = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/input/minimum_bias/segments.list
tree_input_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/truth_root
partial_output_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/truth_pt_partial/prompt_eta07_unweighted
log_directory      = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor
n_bins             = 100
pt_max             = 20.0
max_abs_eta        = 0.7
use_event_weight   = false

Output             = $(log_directory)/pythia_truth_pt_partial_$(ClusterId)_$(ProcId).out
Error              = $(log_directory)/pythia_truth_pt_partial_$(ClusterId)_$(ProcId).err
Log                = /tmp/ryotaro-PhotonAnalysisTree-pythia-truth-pt-partial_$(ClusterId)_$(ProcId).log
Arguments          = "$(ProcId) $(chunk_offset) $(total_files) $(files_per_job) $(input_manifest) $(tree_input_directory) $(partial_output_directory) $(n_bins) $(pt_max) $(max_abs_eta) $(use_event_weight)"

# n_chunks must equal ceil(total_files / files_per_job) - chunk_offset. Examples:
#   40,000 files: defaults, then
#     condor_submit -maxjobs 80 run_truth_pt_partial_pythia.job
#   200,000 files:
#     condor_submit -append "total_files = 200000" -append "n_chunks = 400" -maxjobs 400 run_truth_pt_partial_pythia.job
#   Continue from the existing first 40,000 files through 200,000:
#     condor_submit -append "total_files = 200000" -append "chunk_offset = 80" -append "n_chunks = 320" -maxjobs 320 run_truth_pt_partial_pythia.job
Queue $(n_chunks)
