Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/diagnostics/tagging_purity
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/diagnostics/tagging_purity/run_reduce.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
request_memory     = 2GB
Priority           = 20
job_lease_duration = 86400

map_root           = /sphenix/tg/tg01/coldqcd/ryotaro/DirectPhotonAnalysis/photon_candidate_selection/$(configuration)
output_file        = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/tagging_purity_diagnostic/productions/historical/$(configuration)/partials/jet/jet12/shard_$(shard)/tagging_purity_diagnostic.root
log_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/tagging_purity_diagnostic
Output = $(log_directory)/reduce_jet12_shards_$(ProcId).out
Error = $(log_directory)/reduce_jet12_shards_$(ProcId).err
Log = /tmp/ryotaro-PhotonAnalysisTree-tagging_purity_diagnostic-reduce_jet12_shards_$(ProcId).log
Arguments          = "$(map_root) $(output_file) $(threshold) jet12 $(shard) 10 true 0"

Queue configuration, threshold, shard from (
  cluster_e_gt_0p2 0.2 0
  cluster_e_gt_0p2 0.2 1
  cluster_e_gt_0p2 0.2 2
  cluster_e_gt_0p2 0.2 3
  cluster_e_gt_0p2 0.2 4
  cluster_e_gt_0p2 0.2 5
  cluster_e_gt_0p2 0.2 6
  cluster_e_gt_0p2 0.2 7
  cluster_e_gt_0p2 0.2 8
  cluster_e_gt_0p2 0.2 9
  cluster_e_gt_0p5 0.5 0
  cluster_e_gt_0p5 0.5 1
  cluster_e_gt_0p5 0.5 2
  cluster_e_gt_0p5 0.5 3
  cluster_e_gt_0p5 0.5 4
  cluster_e_gt_0p5 0.5 5
  cluster_e_gt_0p5 0.5 6
  cluster_e_gt_0p5 0.5 7
  cluster_e_gt_0p5 0.5 8
  cluster_e_gt_0p5 0.5 9
)
