# Set production_directory to a new configuration initialized with tools/software.py production.
production_directory = UNCONFIGURED
production_manifest = $(production_directory)/manifest.json
Environment = "PHOTON_PRODUCTION_MANIFEST=$(production_manifest)"
Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/photon_candidate_selection
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/photon_candidate_selection/run_reduce.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

family             = jet
configuration      = ClusterE0p12_Pi0Partner0p5
require_complete   = true
n_bins             = 40
et_max             = 40.0
map_root            = $(production_directory)/maps
partial_root        = $(production_directory)/partials/$(family)
output_base         = $(partial_root)/$(sample_name)/shard_0/photon_candidate_selection
log_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/photon_candidate_selection

Output = $(log_directory)/reduce_jet_samples_$(ProcId).out
Error = $(log_directory)/reduce_jet_samples_$(ProcId).err
Log = /tmp/ryotaro-PhotonAnalysisTree-photon_candidate_selection-reduce_jet_samples_$(ProcId).log

Arguments          = "$(family) $(map_root) $(output_base) $(require_complete) $(n_bins) $(et_max) $(sample_name) 0"

# Override sample_names with condor_submit -append to retry a subset.
sample_names = jet3,jet5,jet8,jet20,jet30,jet40
Queue sample_name in $(sample_names)
