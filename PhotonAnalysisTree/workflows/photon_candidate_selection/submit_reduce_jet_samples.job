Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/photon_candidate_selection
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/photon_candidate_selection/run_reduce.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

family             = jet
configuration      = cluster_e_gt_0p5
require_complete   = true
n_bins             = 200
et_max             = 40.0
map_root            = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/intermediate_files/photon_candidate_selection/$(configuration)
partial_root        = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/plots/photon_candidate_selection/reduce/$(configuration)/$(family)/partial
output_base         = $(partial_root)/$(sample_name)/shard_0/photon_candidate_selection
log_directory       = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/photon_candidate_selection/reduce

Output             = $(log_directory)/selection_all_$(family)_$(configuration)_$(sample_name)_shard_0.out
Error              = $(log_directory)/selection_all_$(family)_$(configuration)_$(sample_name)_shard_0.err
Log                = /tmp/ryotaro-PhotonAnalysisTree-photon-candidate-selection-all-$(family)-$(configuration)-$(sample_name)-shard-0.log

Arguments          = "$(family) $(map_root) $(output_base) $(require_complete) $(n_bins) $(et_max) $(sample_name) 0"

# Override sample_names with condor_submit -append to retry a subset.
sample_names = jet3,jet5,jet8,jet20,jet30,jet40
Queue sample_name in $(sample_names)
