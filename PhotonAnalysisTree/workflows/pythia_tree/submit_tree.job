Universe           = vanilla
Initialdir = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/pythia_tree
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/pythia_tree/run_tree.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:100
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

n_events           = 0
tree_output_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/pythia_tree/productions/historical/default/maps
log_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/pythia_tree

Output = $(log_directory)/tree_$(ProcId).out
Error = $(log_directory)/tree_$(ProcId).err
Log = /tmp/ryotaro-PhotonAnalysisTree-pythia_tree-tree_$(ProcId).log
Arguments          = "$(input_suffix) $(n_events) $(tree_output_directory)"

# One manifest row is one synchronized four-stream DST file set.
Queue input_suffix from /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/input/jet5/segments.list
