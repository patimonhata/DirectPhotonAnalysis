log_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/single_particle
Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/single_particle
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/single_particle/run_add_scores.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold        = (ExitBySignal == true) || (ExitCode != 0)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:100
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

job_offset         = 0
n_jobs            = 5000
process_id         = $(Process) + $(job_offset)
tree_directory     = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/single_particle/productions/historical/default/maps
output_directory   = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor

input_file         = $(tree_directory)/photon_analysis_tree_$INT(process_id,%06d).root
final_output_file  = $(tree_directory)/photon_analysis_tree_$INT(process_id,%06d)_scored.root

Output = $(log_directory)/scores_$(ProcId).out
Error = $(log_directory)/scores_$(ProcId).err
Log = /tmp/ryotaro-PhotonAnalysisTree-single_particle-scores_$(ProcId).log
Arguments          = "$(input_file) $(final_output_file)"

Queue $(n_jobs)
