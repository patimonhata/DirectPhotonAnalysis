Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/studies/pi0_cluster_multiplicity
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/studies/pi0_cluster_multiplicity/run_partial.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
concurrency_limits = CONCURRENCY_LIMIT_DEFAULT:100
request_memory     = 4GB
Priority           = 20
job_lease_duration = 86400

# Defaults are a small 100-file pilot. Increase only after validating the pilot.
total_files        = 10000
files_per_job      = 10
n_chunks           = 1000
chunk_offset       = 0
input_manifest     = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/input/jet12/segments.list
partial_output_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/pi0_cluster_multiplicity/productions/historical/jet12_10k/partials/primary_generator_truth_eta07
log_directory = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/pi0_cluster_multiplicity
pt_bins            = 100
pt_max             = 20.0
multiplicity_max   = 20
cluster_energy_bins = 100
cluster_energy_max = 20.0
truth_eta_max      = 0.7

Output = $(log_directory)/submit_$(ProcId).out
Error = $(log_directory)/submit_$(ProcId).err
Log = /tmp/ryotaro-PhotonAnalysisTree-pi0_cluster_multiplicity-submit_$(ProcId).log
Arguments          = "$(ProcId) $(chunk_offset) $(total_files) $(files_per_job) $(input_manifest) $(partial_output_directory) $(pt_bins) $(pt_max) $(multiplicity_max) $(cluster_energy_bins) $(cluster_energy_max) $(truth_eta_max)"

# Require n_chunks = ceil(total_files / files_per_job) - chunk_offset.
Queue $(n_chunks)
