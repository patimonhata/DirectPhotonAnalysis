Universe           = vanilla
Initialdir         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/tagging_purity_diagnostic
Executable         = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/workflows/tagging_purity_diagnostic/run_reduce.sh

PeriodicHold       = (NumJobStarts >= 1 && JobStatus == 1)
OnExitHold         = (ExitBySignal == true) || (ExitCode != 0)
request_memory     = 2GB
Priority           = 20
job_lease_duration = 86400

map_root           = /sphenix/tg/tg01/coldqcd/ryotaro/DirectPhotonAnalysis/photon_candidate_selection/$(configuration)
output_file        = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/plots/tagging_purity_diagnostic/reduce/$(configuration)/jet/partial/jet12/shard_$(shard)/tagging_purity_diagnostic.root
log_directory      = /sphenix/user/ryotaro/DirectPhotonAnalysis/PhotonAnalysisTree/output/condor/tagging_purity_diagnostic/reduce
Output             = $(log_directory)/$(configuration)_jet12_shard_$(shard).out
Error              = $(log_directory)/$(configuration)_jet12_shard_$(shard).err
Log                = /tmp/ryotaro-tagging-purity-$(configuration)-jet12-shard-$(shard).log
Arguments          = "$(map_root) $(output_file) $(threshold) jet12 $(shard) 10 true 0"

Queue configuration, threshold, shard from (
  cluster_e_gt_0p2 0.2 0
  cluster_e_gt_0p2 0.2 1
  cluster_e_gt_0p2 0.2 2
  cluster_e_gt_0p2 0.2 3
  cluster_e_gt_0p2 0.2 4
  cluster_e_gt_0p2 0.2 5
  cluster_e_gt_0p2 0.2 6
  cluster_e_gt_0p2 0.2 7
  cluster_e_gt_0p2 0.2 8
  cluster_e_gt_0p2 0.2 9
  cluster_e_gt_0p5 0.5 0
  cluster_e_gt_0p5 0.5 1
  cluster_e_gt_0p5 0.5 2
  cluster_e_gt_0p5 0.5 3
  cluster_e_gt_0p5 0.5 4
  cluster_e_gt_0p5 0.5 5
  cluster_e_gt_0p5 0.5 6
  cluster_e_gt_0p5 0.5 7
  cluster_e_gt_0p5 0.5 8
  cluster_e_gt_0p5 0.5 9
)
